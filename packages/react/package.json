{
  "name": "@muslim-icons/react",
  "version": "0.3.1",
  "description": "104 distinct Muslim-themed outline SVG icons for React",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kolapoimam/muslim-icons.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/kolapoimam/muslim-icons/blob/main/packages/react/README.md",
  "bugs": {
    "url": "https://github.com/kolapoimam/muslim-icons/issues"
  },
  "keywords": [
    "icons",
    "svg",
    "react",
    "typescript",
    "muslim",
    "islamic",
    "ramadan",
    "hajj",
    "quran"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "@types/react": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
